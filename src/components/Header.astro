---
import Logo from "./Logo.astro";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 transition-all duration-300"
>
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
    <div
      id="header-bar"
      class="flex items-center justify-between rounded-full px-5 py-3 transition-all duration-300"
    >
      <Logo tone="terracotta" />

      <div class="flex items-center gap-4">
        <span
          class="hidden text-xs uppercase tracking-widest text-espresso/50 sm:inline"
        >
          Tokyo · Spring 2027
        </span>
        <a href="#waitlist" class="btn-primary px-5 py-2.5 text-sm">
          Get early access
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Frost the bar once you've scrolled past the hero's top. IntersectionObserver
  // on a sentinel rather than a scroll listener — no work during scroll.
  const bar = document.getElementById("header-bar");
  const sentinel = document.createElement("div");
  sentinel.style.cssText = "position:absolute;top:0;height:80px;width:1px;";
  document.body.prepend(sentinel);

  new IntersectionObserver(
    ([entry]) => {
      bar?.classList.toggle("bg-cream/80", !entry.isIntersecting);
      bar?.classList.toggle("backdrop-blur-xl", !entry.isIntersecting);
      bar?.classList.toggle("shadow-sm", !entry.isIntersecting);
      bar?.classList.toggle("ring-1", !entry.isIntersecting);
      bar?.classList.toggle("ring-espresso/5", !entry.isIntersecting);
    },
    { threshold: 0 },
  ).observe(sentinel);
</script>
