---
/*
 * The route spine (SPEC §5.6b): a dotted path down the left gutter that a
 * terracotta line "walks" over as you scroll, with station dots at each
 * section that fill as you pass them. Desktop (xl:) only — the gutter doesn't
 * exist at smaller widths.
 *
 * Progressive enhancement, strictly: the draw-on-scroll uses CSS
 * scroll-driven animations; browsers without support (and reduced-motion
 * users) see only the static dotted path, which still works as a design
 * element. Station dots are positioned by a tiny script because section
 * offsets aren't knowable at build time.
 */
const stations = ["walk", "why", "locals", "tokyo", "waitlist"];
---

<div
  id="walk-path"
  class="pointer-events-none absolute inset-y-0 left-0 hidden w-20 overflow-hidden xl:block"
  aria-hidden="true"
  data-stations={stations.join(",")}
>
  <svg
    class="ml-4 h-full w-10"
    viewBox="0 0 60 1000"
    preserveAspectRatio="none"
    fill="none"
  >
    <!-- the planned route: dotted, quiet -->
    <path
      class="walk-base"
      d="M30 0 C 40 90, 20 180, 30 280 S 42 470 30 570 S 18 780 30 880 S 36 960 30 1000"
      pathLength="1"
      stroke-dasharray="0.0018 0.0105"
      stroke-width="3"
      stroke-linecap="round"
    ></path>
    <!-- the walked route: draws over it with scroll -->
    <path
      class="walk-progress"
      d="M30 0 C 40 90, 20 180, 30 280 S 42 470 30 570 S 18 780 30 880 S 36 960 30 1000"
      pathLength="1"
      stroke-width="3.5"
      stroke-linecap="round"
    ></path>
  </svg>
</div>

<style>
  .walk-base {
    stroke: var(--color-espresso);
    opacity: 0.18;
  }

  .walk-progress {
    stroke: var(--color-terracotta);
    /* hidden unless the browser can drive it from scroll */
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .walk-progress {
      display: block;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: walk-draw linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes walk-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* station dots, appended by the script below */
  :global(.walk-station) {
    position: absolute;
    left: 2.25rem; /* svg centre: ml-4 (16px) + w-10/2 (20px), dot centred */
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: var(--color-cream);
    border: 3px solid rgba(53, 29, 6, 0.25);
    transition:
      border-color 0.4s,
      background-color 0.4s,
      transform 0.4s;
  }

  :global(.walk-station.passed) {
    background: var(--color-terracotta);
    border-color: var(--color-terracotta);
    transform: translate(-50%, -50%) scale(1.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .walk-progress {
      display: none;
    }
  }
</style>

<script>
  const wrap = document.getElementById("walk-path");

  if (wrap) {
    const ids = (wrap.dataset.stations || "").split(",");
    const dots = ids
      .map((id) => {
        const section = document.getElementById(id);
        if (!section) return null;
        const dot = document.createElement("span");
        dot.className = "walk-station";
        wrap.appendChild(dot);
        return { section, dot };
      })
      .filter((d) => d !== null);

    const place = () => {
      // Section offsets are relative to the shared positioned wrapper.
      dots.forEach(({ section, dot }) => {
        dot.style.top = `${section.offsetTop + 120}px`;
      });
    };

    let raf = 0;
    const mark = () => {
      raf = 0;
      const line = window.scrollY + window.innerHeight * 0.6;
      dots.forEach(({ section, dot }) => {
        dot.classList.toggle("passed", line > section.offsetTop + 120);
      });
    };

    place();
    mark();
    // Observe main (the content that actually determines section offsets),
    // not body — body's size can itself be affected by overflowing absolute
    // children, which risks a reposition feedback loop. The overflow-hidden
    // on the wrapper guards the same failure from the other side.
    const content = document.getElementById("main");
    if (content) new ResizeObserver(place).observe(content);
    window.addEventListener(
      "scroll",
      () => {
        if (!raf) raf = requestAnimationFrame(mark);
      },
      { passive: true },
    );
  }
</script>
