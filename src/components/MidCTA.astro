---
/*
 * One calm conversion beat between the Tokyo section (peak persuasion) and the
 * FAQ. Deliberately NOT a third email form — an anchor to the waitlist keeps
 * the page from looking needy while removing the ~4,500px CTA gap.
 */
---

<section class="px-4 py-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div
      class="reveal flex flex-col items-center gap-4 rounded-[2rem] bg-sand/35 px-6 py-6 ring-1 ring-inset ring-espresso/10 sm:flex-row sm:justify-between sm:rounded-full sm:px-8 sm:py-4"
    >
      <p class="text-center font-display text-lg font-bold text-espresso sm:text-left">
        Walk Tokyo first, spring 2027.
      </p>
      <a href="#waitlist" class="btn-primary shrink-0 px-6 py-3 text-sm">
        Get early access
      </a>
    </div>
  </div>
</section>
