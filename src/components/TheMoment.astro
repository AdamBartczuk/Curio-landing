---
import MediaPlaceholder from "./MediaPlaceholder.astro";
---

<!-- Carries the differentiator: the single point, not the planned tour. -->
<section class="px-4 py-20 sm:px-6 sm:py-28" id="the-moment">
  <div class="mx-auto max-w-6xl">
    <div class="overflow-hidden rounded-[2.5rem] bg-espresso text-cream">
      <div class="grid gap-0 lg:grid-cols-2">
        <div class="reveal order-2 flex flex-col justify-center p-8 sm:p-12 lg:order-1 lg:p-16">
          <p class="chip mb-8 w-fit bg-cream/10 text-cream/70">
            Explore mode
          </p>

          <h2 class="display-lg">
            You're not lost.<br />
            You're just <span class="text-sand">curious.</span>
          </h2>

          <div class="mt-8 space-y-5 text-lg leading-relaxed text-cream/75">
            <p>
              You're somewhere in the city without a plan. A gate at the end of a
              side street. A tree everyone is photographing. A building that's
              older than everything around it.
            </p>
            <p>
              Normally you shrug and walk past. Or you stop, type a guess into a
              search box, and read three paragraphs of the wrong thing.
            </p>
            <p class="font-medium text-cream">
              With Curio you tap it, and someone tells you.
            </p>
          </div>

          <p class="mt-10 border-t border-cream/15 pt-6 text-sm text-cream/50">
            No route to start. No tour to finish. Stop whenever you like.
          </p>
        </div>

        <div class="relative order-1 lg:order-2">
          <MediaPlaceholder
            id="VID-01"
            label="Looping video — POV walking a narrow Tokyo alley at dusk, lanterns, phone tapped once then pocketed"
            kind="video"
            ratio="4/5"
            class="h-full rounded-none"
          />
          <span
            class="chip float-soft absolute left-6 top-8 bg-terracotta text-cream shadow-lg"
          >
            Audio
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
