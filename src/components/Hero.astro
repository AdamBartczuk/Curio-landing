---
import AudioPlayer from "./islands/AudioPlayer.tsx";
import WaitlistForm from "./islands/WaitlistForm.tsx";

/*
 * TOKYO SWAP — the sample below is the old Cracow teaser, used as a placeholder.
 * Replace with a Tokyo clip: put the MP3 at public/media/tokyo-sample.mp3 and
 * change `sampleSrc` to "/media/tokyo-sample.mp3", plus `place` and `title`.
 */
const sampleSrc =
  "https://trexuhtydiwygtxugqfb.supabase.co/storage/v1/object/public/Landing%20page/Curio_cracow_teaser.mp3";
// "early sample", not "placeholder" — visitors see this label.
const samplePlace = "Kraków · early sample";
const sampleTitle = "The Other Capital";
---

<section class="relative px-4 pb-16 pt-24 sm:px-6 sm:pt-28" id="hero">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <!-- Left: the promise -->
      <div>
        <p
          class="chip mb-6 bg-sand/60 text-espresso"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-terracotta"></span>
          Tokyo first · cherry blossom 2027
        </p>

        <h1 class="display-xl text-espresso">
          See something?<br />
          <span class="text-terracotta">Hear its story.</span>
        </h1>

        <p class="mt-5 max-w-lg text-lg leading-relaxed text-espresso/75 sm:text-xl">
          Curio is an audio guide for people without a plan. Tap whatever is in
          front of you and hear a short story about it, written by someone who
          actually lives there. No route to plan and nothing to look up. Start
          walking.
        </p>

        <!-- Form directly after the promise — it must sit above the fold on
             a 720–800px desktop. Chips moved below; they're seasoning. -->
        <div class="mt-7" id="hero-form">
          <WaitlistForm client:idle buttonText="Get early access" />
          <p class="mt-3 px-2 text-sm text-espresso/50">
            A free premium weekend in your first city. We email about the launch
            and nothing else.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip bg-espresso text-cream">Audio-first</span>
          <span class="chip bg-sand/60 text-espresso">Just walk</span>
          <span class="chip bg-sand/60 text-espresso">Works offline</span>
        </div>
      </div>

      <!-- Right: proof you can hear -->
      <div class="relative mx-auto w-full max-w-sm lg:mx-0 lg:max-w-md">
        <img
          src="/media/hero-tokyo.webp"
          alt="A traveller walking a Tokyo backstreet at golden hour, headphones on, looking up at something off-frame"
          width="1140"
          height="1425"
          class="aspect-[4/5] w-full rounded-[2rem] object-cover shadow-xl"
          fetchpriority="high"
          data-depth="6"
        />

        <!-- Floating brand labels, per style guide pp.15-18. Parallax lives on
             the wrapper: float-soft animates the chip's own transform, and an
             animation would override an inline transform on the same node. -->
        <span class="absolute -left-3 top-10 sm:-left-5" data-depth="20">
          <span class="chip float-soft bg-terracotta text-cream shadow-lg">
            GPS
          </span>
        </span>
        <span class="absolute -right-2 top-1/4 sm:-right-4" data-depth="-14">
          <span
            class="chip float-soft bg-sand text-espresso shadow-lg"
            style="animation-delay:-2.5s"
          >
            Explore
          </span>
        </span>

        <!-- The single most important element on the page: press play.
             Overlaps the image bottom so it reads as part of the card. -->
        <div class="relative z-10 -mt-16 px-3 sm:px-5">
          {/* client:idle, not client:visible — the player is above the fold on
              load, and it's the page's centrepiece: don't gate its hydration
              on IntersectionObserver quirks. */}
          <AudioPlayer
            client:idle
            src={sampleSrc}
            place={samplePlace}
            title={sampleTitle}
            note="A real Curio story from Kraków, where we tested it first. This is the whole thing."
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pointer parallax (SPEC §5.6d): the floating chips and hero image drift a
  // few px with the cursor. Mouse-only devices, and never under
  // prefers-reduced-motion. Smoothing comes from a CSS transition, so there is
  // no continuous rAF loop — work only happens on actual pointer movement.
  const zone = document.getElementById("hero");
  const wantsMotion =
    window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (zone && wantsMotion) {
    const els = zone.querySelectorAll<HTMLElement>("[data-depth]");
    els.forEach((el) => {
      el.style.transition = "transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)";
    });

    let mx = 0;
    let my = 0;
    let raf = 0;

    const apply = () => {
      raf = 0;
      els.forEach((el) => {
        const depth = Number(el.dataset.depth) || 0;
        el.style.transform = `translate(${(mx * depth).toFixed(1)}px, ${(my * depth).toFixed(1)}px)`;
      });
    };

    zone.addEventListener("mousemove", (e) => {
      const r = zone.getBoundingClientRect();
      mx = (e.clientX - r.left) / r.width - 0.5;
      my = (e.clientY - r.top) / r.height - 0.5;
      if (!raf) raf = requestAnimationFrame(apply);
    });

    zone.addEventListener("mouseleave", () => {
      mx = 0;
      my = 0;
      if (!raf) raf = requestAnimationFrame(apply);
    });
  }
</script>
