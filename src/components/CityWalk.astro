---
/*
 * The interactive centrepiece (SPEC §5.6a, revised): a real Mapbox map of
 * Yanaka — Tokyo's old quarter — replaces the earlier stylized SVG, which
 * Adam found too abstract. Copy + story card sit in a frosted panel overlaid
 * on the LEFT of the map; the pins live on the map itself, to the right.
 *
 * Map: Mapbox Standard style at dusk (warm golden light + 3D buildings — the
 * same golden-hour mood as the brand photography), lazy-initialised so the
 * ~1.5MB GL bundle never blocks first paint. Until GL boots (or if JS is
 * off), the container shows a Static-Images-API frame of the same view.
 *
 * The access token below is a Mapbox PUBLIC token (pk.) — designed to ship in
 * client code. Restrict it to curio.guide + localhost in the Mapbox dashboard.
 *
 * Honesty rules still apply: pins are "sample stops" and say so — archetypal
 * teasers, no invented facts about real venues, no fake audio (the one real
 * clip stays in the hero player).
 */
const MAPBOX_TOKEN =
  import.meta.env.PUBLIC_MAPBOX_TOKEN ?? "";

// Yanaka / Nezu / Sendagi — sakura, temples, and streets that survived 1945.
const MAP_CENTER: [number, number] = [139.7635, 35.7235];
const MAP_ZOOM = 14.8;

const stops = [
  {
    id: "gate",
    name: "The gate",
    lng: 139.7702,
    lat: 35.7278,
    teaser:
      "Everyone photographs the famous gate two streets over. This one is older, quieter, and the reason the street bends the way it does. Worth thirty seconds of your walk.",
  },
  {
    id: "tree",
    name: "The tree",
    lng: 139.7668,
    lat: 35.7208,
    teaser:
      "One tree, forty photographers, every April. The story isn't the blossom — it's who planted it, and why the whole block once fought to keep it.",
  },
  {
    id: "building",
    name: "The old building",
    lng: 139.7645,
    lat: 35.7266,
    teaser:
      "Three earthquakes, one war, and a stubborn owner who wouldn't sell. The newest thing on this building is the vending machine outside.",
  },
  {
    id: "izakaya",
    name: "The corner izakaya",
    lng: 139.7689,
    lat: 35.7241,
    teaser:
      "Six seats, no menu, and one firm opinion about how you should drink your beer. The person who wrote this story has been thrown out twice.",
  },
  {
    id: "bridge",
    name: "The bridge",
    lng: 139.7713,
    lat: 35.7183,
    teaser:
      "Cross it at five in the evening and you'll share it with half the neighbourhood. There's a reason everyone pauses in the middle, and it isn't the view.",
  },
];

// Instant-paint fallback while GL boots (and the no-JS view).
const staticMapUrl =
  `https://api.mapbox.com/styles/v1/mapbox/dark-v11/static/` +
  `${MAP_CENTER[0]},${MAP_CENTER[1]},${MAP_ZOOM - 0.6},0/1280x720@2x` +
  `?access_token=${MAPBOX_TOKEN}&logo=false`;
---

<section class="px-4 py-20 sm:px-6 sm:py-28" id="walk">
  <div class="mx-auto max-w-6xl">
    <div
      class="reveal relative overflow-hidden rounded-[2.5rem] bg-espresso text-cream"
    >
      <!-- Map: in-flow block on mobile, full-bleed backdrop on lg. The
           positioning lives on this wrapper, NOT on the GL container —
           mapbox-gl.css forces `position: relative` on its container and
           would silently cancel an absolute placement (collapsing it to
           zero height). The static frame here also paints while GL boots. -->
      <div
        class="h-[400px] w-full bg-cover bg-center sm:h-[480px] lg:absolute lg:inset-0 lg:h-full"
        style={`background-image:url('${staticMapUrl}')`}
      >
        <div
          id="city-map"
          class="h-full w-full"
          data-center={MAP_CENTER.join(",")}
          data-zoom={MAP_ZOOM}
          data-token={MAPBOX_TOKEN}
        >
        </div>
      </div>

      <!-- Left overlay: copy + the story card the pins drive -->
      <div
        class="relative z-10 p-6 sm:p-8 lg:flex lg:min-h-[680px] lg:w-[46%] lg:flex-col lg:justify-center lg:p-12"
      >
        <div
          class="rounded-[2rem] bg-espresso/80 p-7 ring-1 ring-inset ring-cream/10 backdrop-blur-md sm:p-8"
        >
          <p class="chip mb-6 w-fit bg-cream/10 text-cream/70">Explore mode</p>

          <h2 class="display-lg">
            You're not lost.<br />
            You're just <span class="text-sand">curious.</span>
          </h2>

          <p class="mt-5 max-w-md leading-relaxed text-cream/75">
            A gate at the end of a side street. A tree everyone is
            photographing. A building older than everything around it.
            Normally you shrug and walk past — with Curio you tap it, and
            someone tells you.
          </p>

          <p class="mt-4 text-sm text-cream/50">Try it. Tap a pin on the map.</p>

          <!-- Story card slot: swapped by the pins -->
          <div class="mt-6">
            {
              stops.map((s, i) => (
                <article
                  id={`stop-card-${s.id}`}
                  data-card={s.id}
                  class="stop-card rounded-[1.5rem] bg-cream/[0.08] p-5 ring-1 ring-inset ring-cream/15 sm:p-6"
                  hidden={i !== 0}
                >
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="chip bg-terracotta text-cream">
                      Stop 0{i + 1} · {s.name}
                    </p>
                    <span class="chip bg-cream/10 text-cream/60">
                      2 min listen
                    </span>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-cream/80 sm:text-base">
                    {s.teaser}
                  </p>
                  <a
                    href="#waitlist"
                    class="mt-3 inline-block text-sm font-medium text-sand underline-offset-2 hover:underline"
                  >
                    Hear stories like this →
                  </a>
                </article>
              ))
            }
          </div>

          <p class="mt-5 text-xs text-cream/40">
            Yanaka — Tokyo's old quarter. Sample stops; the full story map
            arrives with launch.
          </p>
        </div>
      </div>

      <!-- Floating brand chips over the map (desktop; the map is behind) -->
      <span
        class="chip float-soft absolute right-8 top-8 z-10 hidden bg-terracotta text-cream shadow-lg lg:inline-flex"
      >
        GPS
      </span>
      <span
        class="chip float-soft absolute bottom-10 right-1/4 z-10 hidden bg-sand text-espresso shadow-lg lg:inline-flex"
        style="animation-delay:-3s"
      >
        Explore
      </span>

      <!-- Pins: server-rendered here, adopted as geo-anchored map markers by
           the script. Staging box is invisible but keeps them in the DOM
           (and focusable in order) if GL never boots. -->
      <div id="pin-staging" class="absolute inset-x-6 bottom-6 z-10 flex gap-3 lg:inset-auto">
        {
          stops.map((s, i) => (
            <button
              type="button"
              class="map-pin"
              style={`--pulse-delay:${i * 0.7}s`}
              data-stop={s.id}
              data-lnglat={`${s.lng},${s.lat}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`stop-card-${s.id}`}
            >
              <span class="sr-only">{s.name} — show story teaser</span>
              <span class="pin-dot" aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .map-pin {
    /* ≥44px hit area */
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    cursor: pointer;
  }

  .pin-dot {
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-terracotta);
    box-shadow:
      0 0 0 4px rgba(254, 240, 227, 0.9),
      0 4px 12px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .map-pin:hover .pin-dot {
    transform: scale(1.2);
  }

  /* soft radar pulse, staggered per pin */
  .pin-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid rgba(254, 240, 227, 0.75);
    animation: pin-pulse 2.8s ease-out infinite;
    animation-delay: var(--pulse-delay, 0s);
  }

  @keyframes pin-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* active pin inverts: cream shell, terracotta core */
  .map-pin[aria-expanded="true"] .pin-dot {
    background: var(--color-cream);
    box-shadow:
      0 0 0 4px var(--color-terracotta),
      0 0 0 8px rgba(254, 240, 227, 0.35),
      0 4px 12px rgba(0, 0, 0, 0.35);
    transform: scale(1.15);
  }

  .map-pin[aria-expanded="true"] .pin-dot::after {
    animation: none;
    opacity: 0;
  }

  .stop-card {
    animation: card-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Mapbox chrome, nudged toward the brand */
  #city-map :global(.mapboxgl-ctrl-attrib) {
    background: rgba(53, 29, 6, 0.6);
    color: rgba(254, 240, 227, 0.6);
    border-radius: 999px 0 0 0;
  }

  #city-map :global(.mapboxgl-ctrl-attrib a) {
    color: rgba(254, 240, 227, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .pin-dot::after {
      animation: none;
      opacity: 0;
    }
    .stop-card {
      animation: none;
    }
  }
</style>

<script>
  const mapEl = document.getElementById("city-map");
  const staging = document.getElementById("pin-staging");
  const pins = document.querySelectorAll<HTMLButtonElement>("[data-stop]");
  const cards = document.querySelectorAll<HTMLElement>("[data-card]");

  // Card swapping works with or without the map.
  pins.forEach((pin) => {
    pin.addEventListener("click", () => {
      const id = pin.dataset.stop;
      pins.forEach((p) => p.setAttribute("aria-expanded", String(p === pin)));
      cards.forEach((c) => {
        c.hidden = c.dataset.card !== id;
      });
      window.dispatchEvent(new CustomEvent("curio:pin-opened"));
    });
  });

  // Lazy-boot Mapbox GL: when the section approaches the viewport, with an
  // idle-time fallback for environments where IntersectionObserver is quiet.
  let booted = false;

  const boot = async () => {
    if (booted || !mapEl) return;
    booted = true;

    const [{ default: mapboxgl }] = await Promise.all([
      import("mapbox-gl"),
      import("mapbox-gl/dist/mapbox-gl.css"),
    ]);

    mapboxgl.accessToken = mapEl.dataset.token || "";
    const center = (mapEl.dataset.center || "139.7635,35.7235")
      .split(",")
      .map(Number) as [number, number];

    const desktop = window.matchMedia("(min-width: 1024px)").matches;

    const map = new mapboxgl.Map({
      container: mapEl,
      style: "mapbox://styles/mapbox/standard",
      center,
      zoom: Number(mapEl.dataset.zoom) || 14.8,
      // Moderate pitch: still cinematic, but 3D buildings stop swallowing
      // whole streets (and the markers standing on them).
      pitch: desktop ? 40 : 25,
      bearing: -12,
      attributionControl: true,
      // Calm rules: never fight the page scroll, never spin the city.
      scrollZoom: false,
      dragRotate: false,
      pitchWithRotate: false,
      cooperativeGestures: !desktop,
    });

    /* Framing differs by breakpoint and must survive a resize — a window
     * dragged narrow (or a tablet rotating) otherwise keeps the desktop
     * padding and pushes every pin off-screen.
     *   wide: the overlay panel covers ~46%, so pad the viewport left and
     *         let the composed centre sit in the open right side.
     *   narrow: no panel overlap — frame the pin cluster itself. */
    const stopCoords = Array.from(pins).map(
      (p) =>
        (p.dataset.lnglat || "0,0").split(",").map(Number) as [number, number],
    );
    const pinBounds = new mapboxgl.LngLatBounds();
    stopCoords.forEach((c) => pinBounds.extend(c));

    const baseZoom = Number(mapEl.dataset.zoom) || 14.8;

    const frame = () => {
      if (window.matchMedia("(min-width: 1024px)").matches) {
        map.setPadding({ left: 520, top: 0, right: 40, bottom: 0 });
        // Restore zoom as well as centre: coming back from the narrow
        // layout the map would otherwise keep fitBounds' tighter zoom and
        // strand the pins behind the overlay panel.
        map.jumpTo({ center, zoom: baseZoom });
      } else {
        map.setPadding({ left: 0, top: 0, right: 0, bottom: 0 });
        map.fitBounds(pinBounds, {
          padding: { top: 70, bottom: 70, left: 45, right: 45 },
          duration: 0,
        });
      }
    };
    frame();

    // Belt-and-braces beside GL's own ResizeObserver: some embedded webviews
    // throttle observers hard enough that the canvas gets stuck at its boot
    // size. An explicit resize on window resize costs nothing elsewhere.
    window.addEventListener(
      "resize",
      () => {
        map.resize();
        frame();
      },
      { passive: true },
    );

    map.on("style.load", () => {
      const cfg = (k: string, v: unknown) =>
        map.setConfigProperty("basemap", k, v);

      // Dusk = the brand's golden hour.
      cfg("lightPreset", "dusk");
      // "faded" calms the stock hues so our palette below reads cleanly.
      cfg("theme", "faded");

      /* Curation, not cartography. The stock basemap labels every
       * convenience store, bank branch and elementary school — noise that
       * fights the "someone chose this for you" promise. All default POI and
       * transit labels go; a curated landmark layer is added further down.
       * Neighbourhood names stay: they're orientation, not clutter. */
      cfg("showPointOfInterestLabels", false);
      cfg("showTransitLabels", false);
      cfg("showRoadLabels", false);
      cfg("showPlaceLabels", true);

      /* Palette. Mid-tones on purpose — the dusk preset darkens everything
       * it touches, so picking final values here would come out muddy. */
      cfg("colorLand", "#57381C"); // warm ground, reads espresso at dusk
      cfg("colorBuildings", "#6E4A2A");
      cfg("colorGreenspace", "#55552C"); // parks: warm olive, not lawn green
      cfg("colorWater", "#2B3238");
      cfg("colorRoads", "#9C7A56"); // sand
      cfg("colorMotorways", "#B5623F"); // terracotta-leaning
      cfg("colorTrunks", "#A9603E");
      cfg("colorPlaceLabels", "#FEF0E3"); // cream
      cfg("colorAdminBoundaries", "#8A6A4C");
      cfg("roadsBrightness", 0.55);

      // Approximate Yanaka highlight. Swap `coordinates` for a precise
      // boundary GeoJSON if one is ever provided.
      map.addSource("district", {
        type: "geojson",
        data: {
          type: "Feature",
          properties: {},
          geometry: {
            type: "Polygon",
            coordinates: [
              [
                [139.7594, 35.7208],
                [139.7625, 35.7301],
                [139.7716, 35.7312],
                [139.7756, 35.7243],
                [139.7728, 35.7158],
                [139.7636, 35.7152],
                [139.7594, 35.7208],
              ],
            ],
          },
        },
      });
      map.addLayer({
        id: "district-fill",
        type: "fill",
        source: "district",
        slot: "middle",
        paint: { "fill-color": "#CA5137", "fill-opacity": 0.08 },
      });
      map.addLayer({
        id: "district-line",
        type: "line",
        source: "district",
        slot: "middle",
        paint: {
          "line-color": "#CA5137",
          "line-opacity": 0.55,
          "line-width": 2,
          "line-dasharray": [1.5, 2.5],
        },
      });

      /* Curated landmarks: the only POIs on this map. Temples, shrines,
       * gardens, museums and historic sites — the things a story would
       * actually be written about — from Mapbox's own Streets tileset.
       * `filterrank` is Mapbox's prominence score (1 = most prominent), so
       * this keeps the landmarks a visitor would recognise and drops the
       * long tail. */
      map.addSource("landmarks", {
        type: "vector",
        url: "mapbox://mapbox.mapbox-streets-v8",
      });

      /* Temples, shrines, gardens, museums, historic sites — and nothing
       * else. Deliberately NOT filtered by Mapbox's `filterrank`: in Yanaka
       * the interesting places are small, so they rank 3–5 and a strict rank
       * cut removes exactly what we came for. Class does the work instead;
       * `arts_and_entertainment` is narrowed by maki so cinemas and
       * nightlife don't sneak in. */
      const landmarkFilter = [
        "any",
        [
          "in",
          ["get", "class"],
          ["literal", ["park_like", "historic", "religion"]],
        ],
        [
          "in",
          ["get", "maki"],
          [
            "literal",
            [
              "museum",
              "art-gallery",
              "monument",
              "attraction",
              "castle",
              "garden",
              "religious-shinto",
              "religious-buddhist",
              "place-of-worship",
            ],
          ],
        ],
      ] as unknown as never;

      map.addLayer({
        id: "landmark-labels",
        type: "symbol",
        source: "landmarks",
        "source-layer": "poi_label",
        slot: "top",
        minzoom: 13,
        filter: landmarkFilter,
        layout: {
          "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
          "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
          "text-size": 12,
          "text-offset": [0, 1.1],
          "text-anchor": "top",
          "text-max-width": 9,
          "text-padding": 6,
          "icon-allow-overlap": false,
        },
        paint: {
          "text-color": "#EAB894", // sand
          "text-halo-color": "#2A1708",
          "text-halo-width": 1.4,
          "text-opacity": 0.9,
        },
      });

      // A small sand dot under each curated name, so they read as places.
      map.addLayer(
        {
          id: "landmark-dots",
          type: "circle",
          source: "landmarks",
          "source-layer": "poi_label",
          slot: "top",
          minzoom: 13,
          filter: landmarkFilter,
          paint: {
            "circle-radius": 3,
            "circle-color": "#EAB894",
            "circle-opacity": 0.75,
            "circle-stroke-width": 1.5,
            "circle-stroke-color": "#2A1708",
            "circle-stroke-opacity": 0.6,
          },
        },
        "landmark-labels",
      );
    });

    // Adopt the server-rendered pin buttons as geo-anchored markers.
    pins.forEach((pin) => {
      const [lng, lat] = (pin.dataset.lnglat || "0,0").split(",").map(Number);
      // occludedOpacity 1: GL v3 fades markers hidden behind 3D buildings to
      // 20% — at dusk on this palette that reads as "no pins at all".
      // The pins are UI, not scenery; they must always win.
      new mapboxgl.Marker({
        element: pin,
        anchor: "center",
        occludedOpacity: 1,
      })
        .setLngLat([lng, lat])
        .addTo(map);

      pin.addEventListener("click", () => {
        map.easeTo({ center: [lng, lat], duration: 900 });
      });
    });

    // Staging box has served its purpose.
    staging?.classList.remove("flex", "absolute");

    // A gentle establishing drift once, unless the visitor prefers stillness.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      map.once("idle", () => {
        map.easeTo({ bearing: -4, duration: 6000, easing: (t) => t });
      });
    }
  };

  if ("IntersectionObserver" in window && mapEl) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          boot();
        }
      },
      { rootMargin: "600px 0px" },
    );
    io.observe(mapEl);
  }
  // Fallback: idle-boot even if the observer never fires.
  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(() => boot(), { timeout: 4000 });
  } else {
    setTimeout(() => boot(), 2500);
  }
</script>
