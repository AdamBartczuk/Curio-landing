---
/*
 * The interactive centrepiece (SPEC §5.6a, revised): a real Mapbox map of
 * Yanaka — Tokyo's old quarter — replaces the earlier stylized SVG, which
 * Adam found too abstract. Copy + story card sit in a frosted panel overlaid
 * on the LEFT of the map; the pins live on the map itself, to the right.
 *
 * Map: Mapbox Standard style at dusk (warm golden light + 3D buildings — the
 * same golden-hour mood as the brand photography), lazy-initialised so the
 * ~1.5MB GL bundle never blocks first paint. Until GL boots (or if JS is
 * off), the container shows a Static-Images-API frame of the same view.
 *
 * The access token below is a Mapbox PUBLIC token (pk.) — designed to ship in
 * client code. Restrict it to curio.guide + localhost in the Mapbox dashboard.
 *
 * Honesty rules still apply: pins are "sample stops" and say so — archetypal
 * teasers, no invented facts about real venues, no fake audio (the one real
 * clip stays in the hero player).
 */
const MAPBOX_TOKEN =
  import.meta.env.PUBLIC_MAPBOX_TOKEN ?? "";

// Yanaka / Nezu / Sendagi — sakura, temples, and streets that survived 1945.
const MAP_CENTER: [number, number] = [139.7635, 35.7235];
const MAP_ZOOM = 14.8;

/*
 * REAL PLACES, REAL FACTS (2026-08-16). These five stops are actual Yanaka
 * landmarks — three well-known, two quiet — with coordinates from Wikipedia
 * and teasers built only from sourced facts (founding dates, what survived,
 * what is displayed). The earlier archetypal stops ("the corner izakaya")
 * carried invented anecdotes, which is fine for a made-up place and not fine
 * once the pin names a real one. Do not add colour to these that isn't in
 * the source; ASSETS.md lists what each claim rests on.
 *
 * Photos are CC images of the same real places (credited in ASSETS.md),
 * still placeholders for Curio's own photography.
 */
const stops = [
  {
    id: "nezu",
    name: "Nezu Shrine",
    kind: "Landmark",
    photo: "/media/stops/nezu.webp",
    lng: 139.76069,
    lat: 35.72021,
    teaser:
      "Founded in 1705, and the buildings you're looking at are the originals — Important Cultural Properties that outlived the fires, earthquakes and bombing that erased most of Edo Tokyo. Come between early April and early May and the grounds are solid azalea.",
  },
  {
    id: "ginza",
    name: "Yanaka Ginza",
    kind: "Landmark",
    photo: "/media/stops/ginza.webp",
    lng: 139.7665,
    lat: 35.7279,
    teaser:
      "One short shitamachi street of small shops, ending in a staircase called Yuyake Dandan — 'sunset steps'. Stand at the top around six and you'll work out how it got the name, along with everyone else who stopped.",
  },
  {
    id: "cemetery",
    name: "Yanaka Cemetery",
    kind: "Landmark",
    photo: "/media/stops/cemetery.webp",
    lng: 139.77056,
    lat: 35.72528,
    teaser:
      "Around seven thousand graves across ten hectares, an avenue of cherry trees that turns white every April, and the last shogun of Japan buried somewhere among them. The five-storied pagoda that stood here burned down in 1957 and was never rebuilt.",
  },
  {
    id: "asakura",
    name: "Asakura Museum",
    kind: "Quiet one",
    photo: "/media/stops/asakura.webp",
    lng: 139.76855,
    lat: 35.72685,
    teaser:
      "The sculptor Fumio Asakura designed this as his own house and studio; it opened as a museum in 1967, after he died. He worked on human figures and, again and again, on cats — which in this neighbourhood turns out to be the right subject.",
  },
  {
    id: "clock",
    name: "Daimyo Clock Museum",
    kind: "Quiet one",
    photo: "/media/stops/clock.webp",
    lng: 139.7662,
    lat: 35.72128,
    teaser:
      "One man, Sakujiro Kamiguchi, spent a lifetime collecting Edo-period clocks, and this small museum opened in 1972 to hold them. Those clocks kept seasonal hours — daylight was always six hours, so an hour stretched in summer and shrank in winter.",
  },
];

// Hypothetical position for the demo — deliberately NOT the visitor's real
// location (no geolocation is requested anywhere on this page). Sits roughly
// in the middle of the five stops so the radar reads as "what's around me".
const DEMO_POSITION: [number, number] = [139.7665, 35.7243];

// Instant-paint fallback while GL boots (and the no-JS view). light-v11 so
// the flash matches the espresso-ink map that replaces it.
const staticMapUrl =
  `https://api.mapbox.com/styles/v1/mapbox/light-v11/static/` +
  `${MAP_CENTER[0]},${MAP_CENTER[1]},${MAP_ZOOM - 0.6},0/1280x720@2x` +
  `?access_token=${MAPBOX_TOKEN}&logo=false`;
---

<!-- Wider than the rest of the page (max-w-7xl, tighter padding) on purpose:
     this is the interactive centrepiece, and at max-w-6xl the map was losing
     most of its width to page gutters and nested padding. -->
<section class="px-3 py-14 sm:px-6 sm:py-20" id="walk">
  <div class="mx-auto max-w-7xl">
    <div
      class="reveal relative overflow-hidden rounded-[2.5rem] bg-espresso text-cream lg:h-[min(80vh,780px)]"
    >
      <!-- Map: in-flow block on mobile, full-bleed backdrop on lg. The
           positioning lives on this wrapper, NOT on the GL container —
           mapbox-gl.css forces `position: relative` on its container and
           would silently cancel an absolute placement (collapsing it to
           zero height). The static frame here also paints while GL boots. -->
      <div
        class="h-[400px] w-full bg-cover bg-center sm:h-[480px] lg:absolute lg:inset-0 lg:h-full"
        style={`background-image:url('${staticMapUrl}')`}
      >
        <div
          id="city-map"
          class="h-full w-full"
          data-center={MAP_CENTER.join(",")}
          data-zoom={MAP_ZOOM}
          data-token={MAPBOX_TOKEN}
        >
        </div>
      </div>

      <!-- Left overlay: copy + the story card the pins drive. Narrower and
           less inset than before so the map keeps the width it needs. -->
      <div
        class="relative z-10 p-4 sm:p-6 lg:flex lg:h-full lg:w-[40%] lg:max-w-[460px] lg:flex-col lg:justify-center lg:p-6"
      >
        <div
          class="rounded-[2rem] bg-espresso/80 p-6 ring-1 ring-inset ring-cream/10 backdrop-blur-md sm:p-7 lg:overflow-y-auto"
        >
          <p class="chip mb-5 w-fit bg-cream/10 text-cream/70">Explore mode</p>

          <!-- Capped below display-lg on desktop: the panel is a fixed-height
               column here, and the full display size overflowed it. -->
          <h2 class="display-lg lg:text-[2.25rem] xl:text-[2.6rem]">
            You're not lost.<br />
            You're just <span class="text-sand">curious.</span>
          </h2>

          <p class="walk-intro mt-4 max-w-md leading-relaxed text-cream/75 lg:text-sm xl:text-base">
            A gate at the end of a side street. A tree everyone is
            photographing. A building older than everything around it.
            Normally you shrug and walk past — with Curio you tap it, and
            someone tells you.
          </p>

          <p class="mt-4 text-sm text-cream/50">
            Try it. Tap a pin on the map — five real stops in Yanaka.
          </p>

          {/* Below lg the story lands here instead of in a popup: a ~230px
              popup cannot fit above a pin inside a 400px-tall phone map, and
              Mapbox flips it off the map edge. Desktop uses the popup. */}
          <div id="stop-slot" class="walk-popup mt-5 lg:hidden"></div>
        </div>
      </div>

      {/*
        Story cards live here, server-rendered, so the text is in the HTML for
        search engines and for anyone without JS. The script clones a card
        into a Mapbox popup on click; the originals stay put.
      */}
      <div id="stop-cards" class="sr-only">
        {
          stops.map((s, i) => (
            <article id={`stop-card-${s.id}`} data-card={s.id} class="stop-card">
              <p class="stop-kind">
                Stop 0{i + 1} · {s.kind}
              </p>
              <h3 class="stop-name">{s.name}</h3>
              <p class="stop-teaser">{s.teaser}</p>

              {/* Deliberately inert and labelled as such — the narration
                  doesn't exist yet, and a play button that does nothing
                  would be a lie. Swap for the real AudioPlayer island when
                  the clips land. */}
              <div class="stop-audio">
                <span class="stop-audio-play" aria-hidden="true">▶</span>
                <span class="stop-audio-track" aria-hidden="true">
                  <span class="stop-audio-fill" />
                </span>
                <span class="stop-audio-time">2:00</span>
              </div>
              <p class="stop-audio-note">Narration arrives with launch</p>

              <a class="stop-link" href="#waitlist">
                Get early access →
              </a>
            </article>
          ))
        }
      </div>

      <!-- Floating brand chips over the map (desktop; the map is behind) -->
      <span
        class="chip float-soft absolute right-8 top-8 z-10 hidden bg-terracotta text-cream shadow-lg lg:inline-flex"
      >
        GPS
      </span>
      <span
        class="chip float-soft absolute bottom-10 right-1/4 z-10 hidden bg-espresso text-cream shadow-lg lg:inline-flex"
        style="animation-delay:-3s"
      >
        Explore
      </span>

      {/* Hypothetical position + POI radar. Labelled "example" because it is
          one: the page never asks for or uses real geolocation. */}
      <div id="demo-me" class="demo-me" data-lnglat={DEMO_POSITION.join(",")} hidden>
        <span class="demo-me-radar" aria-hidden="true"></span>
        <span class="demo-me-dot" aria-hidden="true"></span>
        <span class="demo-me-label">You are here — example</span>
      </div>

      <!-- Pins: server-rendered here, adopted as geo-anchored map markers by
           the script. Staging box is invisible but keeps them in the DOM
           (and focusable in order) if GL never boots. -->
      <div id="pin-staging" class="absolute inset-x-6 bottom-6 z-10 flex gap-3 lg:inset-auto">
        {
          stops.map((s, i) => (
            <button
              type="button"
              class="map-pin"
              style={`--pulse-delay:${i * 0.7}s`}
              data-stop={s.id}
              data-lnglat={`${s.lng},${s.lat}`}
              aria-expanded="false"
              aria-controls={`stop-card-${s.id}`}
            >
              <span class="sr-only">{s.name} — show story teaser</span>
              <span class="pin-label" aria-hidden="true">{s.name}</span>
              <span class="pin-photo" aria-hidden="true">
                <img src={s.photo} alt="" width="168" height="168" loading="lazy" />
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Disclosure sits outside the card: it must stay readable, and inside
         the panel it was the first thing to get clipped. -->
    <p class="mt-4 px-2 text-xs leading-relaxed text-espresso/45">
      Yanaka — Tokyo's old quarter. Sample stops; the full story map arrives
      with launch. Pin photos are placeholder images of the neighbourhood
      (Wikimedia Commons, CC&nbsp;BY&#8209;SA — credited in ASSETS.md).
    </p>
  </div>
</section>

<style>
  /* A pin is a rounded-square photo with a name above it and a small point
     below — the photo is the "what's there", which is the whole product. */
  .map-pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    /* Anchored bottom-centre on its coordinate (see the Marker offset in the
       script), so the point sits on the place, not the photo's middle. */
    padding-bottom: 6px;
  }

  .pin-label {
    max-width: 128px;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--color-espresso);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(53, 29, 6, 0.28);
    transition:
      background-color 0.25s,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pin-photo {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-sand);
    border: 3px solid var(--color-cream);
    box-shadow: 0 4px 14px rgba(53, 29, 6, 0.35);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s;
  }

  .pin-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* the point: a small rotated square tucked under the photo */
  .pin-photo::before {
    content: "";
    position: absolute;
    bottom: -7px;
    left: 50%;
    width: 12px;
    height: 12px;
    background: var(--color-cream);
    transform: translateX(-50%) rotate(45deg);
    border-radius: 2px;
  }

  .map-pin:hover .pin-photo,
  .map-pin:focus-visible .pin-photo {
    transform: translateY(-4px) scale(1.28);
    border-color: var(--color-terracotta);
  }

  .map-pin:hover .pin-label,
  .map-pin:focus-visible .pin-label {
    transform: translateY(-2px);
  }

  /* soft radar pulse behind the photo, staggered per pin */
  .pin-photo::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 16px;
    border: 2px solid rgba(202, 81, 55, 0.65);
    animation: pin-pulse 2.8s ease-out infinite;
    animation-delay: var(--pulse-delay, 0s);
    pointer-events: none;
  }

  @keyframes pin-pulse {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* active pin: terracotta frame + label, lifted */
  .map-pin[aria-expanded="true"] .pin-photo {
    border-color: var(--color-terracotta);
    transform: translateY(-3px) scale(1.12);
  }

  .map-pin[aria-expanded="true"] .pin-photo::before {
    background: var(--color-terracotta);
  }

  .map-pin[aria-expanded="true"] .pin-label {
    background: var(--color-terracotta);
  }

  .map-pin[aria-expanded="true"] .pin-photo::after {
    animation: none;
    opacity: 0;
  }

  /* Five labels at once is clutter on a phone-width map — show only the
     open one there; every label returns at lg. */
  @media (max-width: 1023px) {
    .map-pin:not([aria-expanded="true"]) .pin-label {
      display: none;
    }
  }

  /* On a short desktop window the panel is a fixed-height column and
     something has to give. Drop the intro paragraph (it restates the hero)
     rather than let the story card — the interactive payoff — be the part
     that scrolls out of sight. */
  @media (min-width: 1024px) and (max-height: 840px) {
    .walk-intro {
      display: none;
    }
  }

  .stop-card {
    animation: card-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------------------------------------------------------------------
     Hypothetical position + POI radar
     --------------------------------------------------------------------- */
  .demo-me {
    display: grid;
    place-items: center;
    position: relative;
  }

  .demo-me-dot {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--color-espresso);
    border: 3px solid var(--color-cream);
    box-shadow: 0 2px 10px rgba(53, 29, 6, 0.45);
    grid-area: 1 / 1;
  }

  /* One sweep every 5s: expands to roughly the POI search radius, then
     rests. Long dead time on purpose — it should read as a heartbeat, not
     a spinner. */
  .demo-me-radar {
    grid-area: 1 / 1;
    width: 72px;
    height: 72px;
    border-radius: 999px;
    border: 2px solid rgba(202, 81, 55, 0.55);
    background: radial-gradient(
      circle,
      rgba(202, 81, 55, 0.16) 0%,
      rgba(202, 81, 55, 0) 70%
    );
    animation: demo-radar 5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes demo-radar {
    0% {
      transform: scale(0.35);
      opacity: 0;
    }
    12% {
      opacity: 0.85;
    }
    70%,
    100% {
      transform: scale(3.1);
      opacity: 0;
    }
  }

  .demo-me-label {
    position: absolute;
    top: 100%;
    margin-top: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(53, 29, 6, 0.88);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------------
     Story popup (the panel's job moved onto the map)
     --------------------------------------------------------------------- */
  :global(.walk-popup .mapboxgl-popup-content) {
    padding: 0;
    border-radius: 1.5rem;
    background: var(--color-espresso);
    color: var(--color-cream);
    box-shadow: 0 18px 40px -12px rgba(53, 29, 6, 0.55);
    max-width: 320px;
  }

  :global(.walk-popup .mapboxgl-popup-tip) {
    border-top-color: var(--color-espresso);
    border-bottom-color: var(--color-espresso);
  }

  :global(.walk-popup .mapboxgl-popup-close-button) {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    color: var(--color-cream);
    font-size: 18px;
    opacity: 0.7;
  }

  :global(.walk-popup .mapboxgl-popup-close-button:hover) {
    background: rgba(254, 240, 227, 0.12);
    opacity: 1;
  }

  :global(.walk-popup .stop-card) {
    padding: 1.15rem 1.25rem 1.25rem;
  }

  /* The mobile slot borrows the popup's inner styles but supplies its own
     shell, since there's no .mapboxgl-popup-content wrapping it. */
  #stop-slot:not(:empty) {
    border-radius: 1.5rem;
    background: rgba(254, 240, 227, 0.08);
    box-shadow: inset 0 0 0 1px rgba(254, 240, 227, 0.15);
    animation: card-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.walk-popup .stop-kind) {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-sand);
  }

  :global(.walk-popup .stop-name) {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
  }

  :global(.walk-popup .stop-teaser) {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(254, 240, 227, 0.8);
  }

  /* Inert audio bar — looks like the real thing is coming, never pretends
     to play. The note under it says so in words. */
  :global(.walk-popup .stop-audio) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    background: rgba(254, 240, 227, 0.08);
  }

  :global(.walk-popup .stop-audio-play) {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(202, 81, 55, 0.55);
    color: var(--color-cream);
    font-size: 10px;
  }

  :global(.walk-popup .stop-audio-track) {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(254, 240, 227, 0.18);
  }

  :global(.walk-popup .stop-audio-fill) {
    display: block;
    width: 22%;
    height: 100%;
    border-radius: 999px;
    background: rgba(234, 184, 148, 0.7);
  }

  :global(.walk-popup .stop-audio-time) {
    font-size: 11px;
    color: rgba(254, 240, 227, 0.5);
  }

  :global(.walk-popup .stop-audio-note) {
    margin-top: 0.4rem;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(254, 240, 227, 0.4);
  }

  :global(.walk-popup .stop-link) {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-sand);
  }

  :global(.walk-popup .stop-link:hover) {
    text-decoration: underline;
  }

  /* Mapbox chrome: attribution is required by the Mapbox ToS and OSM's
     ODbL, so it stays — but compact, in brand, and inset far enough from
     the corner that it can never be clipped by the card's rounded edge. */
  /* 22px, not the default 0: the card has a 2.5rem corner radius and
     `overflow: hidden`, so anything tucked into the very corner gets sliced
     by the curve — which is exactly how the old attribution looked cut. */
  #city-map :global(.mapboxgl-ctrl-bottom-right) {
    right: 22px;
    bottom: 22px;
  }

  #city-map :global(.mapboxgl-ctrl-attrib.mapboxgl-compact) {
    background: rgba(254, 240, 227, 0.92);
    border-radius: 999px;
    min-height: 24px;
    box-shadow: 0 2px 8px rgba(53, 29, 6, 0.18);
  }

  #city-map :global(.mapboxgl-ctrl-attrib a) {
    color: rgba(53, 29, 6, 0.72);
  }

  #city-map :global(.mapboxgl-ctrl-bottom-left) {
    left: 22px;
    bottom: 22px;
  }

  #city-map :global(.mapboxgl-ctrl-logo) {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .pin-photo::after,
    .demo-me-radar {
      animation: none;
      opacity: 0;
    }
    .stop-card {
      animation: none;
    }
  }
</style>

<script>
  const mapEl = document.getElementById("city-map");
  const staging = document.getElementById("pin-staging");
  const pins = document.querySelectorAll<HTMLButtonElement>("[data-stop]");
  const cards = document.querySelectorAll<HTMLElement>("[data-card]");

  const cardFor = (id: string | undefined) =>
    Array.from(cards).find((c) => c.dataset.card === id);

  const clearPins = () =>
    pins.forEach((p) => p.setAttribute("aria-expanded", "false"));

  // Lazy-boot Mapbox GL: when the section approaches the viewport, with an
  // idle-time fallback for environments where IntersectionObserver is quiet.
  let booted = false;

  const boot = async () => {
    if (booted || !mapEl) return;
    booted = true;

    const [{ default: mapboxgl }] = await Promise.all([
      import("mapbox-gl"),
      import("mapbox-gl/dist/mapbox-gl.css"),
    ]);

    mapboxgl.accessToken = mapEl.dataset.token || "";
    const center = (mapEl.dataset.center || "139.7635,35.7235")
      .split(",")
      .map(Number) as [number, number];

    const desktop = window.matchMedia("(min-width: 1024px)").matches;

    const map = new mapboxgl.Map({
      container: mapEl,
      style: "mapbox://styles/mapbox/standard",
      center,
      zoom: Number(mapEl.dataset.zoom) || 14.8,
      // Moderate pitch: still cinematic, but 3D buildings stop swallowing
      // whole streets (and the markers standing on them).
      pitch: desktop ? 40 : 25,
      bearing: -12,
      // Default control replaced below by the compact one — attribution is
      // required by Mapbox's ToS and OSM's ODbL, so it can't be removed,
      // but compact keeps it from being clipped by the card's corner.
      attributionControl: false,
      // Calm rules: never fight the page scroll, never spin the city.
      scrollZoom: false,
      dragRotate: false,
      pitchWithRotate: false,
      cooperativeGestures: !desktop,
    });

    map.addControl(
      new mapboxgl.AttributionControl({ compact: true }),
      "bottom-right",
    );

    /* Framing differs by breakpoint and must survive a resize — a window
     * dragged narrow (or a tablet rotating) otherwise keeps the desktop
     * padding and pushes every pin off-screen.
     *   wide: the overlay panel covers ~46%, so pad the viewport left and
     *         let the composed centre sit in the open right side.
     *   narrow: no panel overlap — frame the pin cluster itself. */
    const stopCoords = Array.from(pins).map(
      (p) =>
        (p.dataset.lnglat || "0,0").split(",").map(Number) as [number, number],
    );
    const pinBounds = new mapboxgl.LngLatBounds();
    stopCoords.forEach((c) => pinBounds.extend(c));

    /* Both breakpoints now FIT the pin cluster rather than trusting a fixed
     * centre/zoom: a fixed frame clipped the eastern pins off the right
     * edge. The asymmetric padding is what keeps the cluster right-of-centre
     * — generous on the left to clear the overlay panel, generous enough on
     * the right that the photo pins (which are ~140px wide with their
     * labels) never touch the edge. */
    const frame = () => {
      const wide = window.matchMedia("(min-width: 1024px)").matches;
      const panel = wide
        ? Math.min(460, mapEl.clientWidth * 0.4) + 40
        : 0;

      map.setPadding({ left: 0, top: 0, right: 0, bottom: 0 });
      map.fitBounds(pinBounds, {
        padding: wide
          ? { left: panel + 90, right: 190, top: 130, bottom: 110 }
          : { left: 60, right: 60, top: 110, bottom: 80 },
        maxZoom: 15.4,
        duration: 0,
      });
    };
    frame();

    // Belt-and-braces beside GL's own ResizeObserver: some embedded webviews
    // throttle observers hard enough that the canvas gets stuck at its boot
    // size. An explicit resize on window resize costs nothing elsewhere.
    window.addEventListener(
      "resize",
      () => {
        map.resize();
        frame();
      },
      { passive: true },
    );

    map.on("style.load", () => {
      const cfg = (k: string, v: unknown) =>
        map.setConfigProperty("basemap", k, v);

      /* "Cream daylight" (picked by Adam from the palette lab, 2026-08-16):
       * the page's own cream as ground, streets barely a shade lighter, soft
       * green parks, terracotta spent only on the story pins. Day light on
       * purpose: the dusk preset's cool ambient crushes warm tones to
       * purple-grey (both dusk lab variants proved it); day renders true. */
      cfg("lightPreset", "day");
      cfg("theme", "faded");

      /* Curation, not cartography. The stock basemap labels every
       * convenience store, bank branch and elementary school — noise that
       * fights the "someone chose this for you" promise. All default POI and
       * transit labels go; a curated landmark layer is added further down.
       * Neighbourhood names stay: they're orientation, not clutter. */
      cfg("showPointOfInterestLabels", false);
      cfg("showTransitLabels", false);
      cfg("showRoadLabels", false);
      cfg("showPlaceLabels", true);

      /* Exact values from the winning lab variant (public/map-lab.html, D).
       * The style's own tone-mapping does the final grading — these inputs
       * are what produced the approved render, so change them together or
       * not at all. Landuse tints (commercial/education/medical/industrial)
       * are pinned to the ground family: unset, they render as the "weird
       * grey stuff" Adam flagged. */
      cfg("colorLand", "#F3E0C8");
      cfg("colorBuildings", "#E9D2B4");
      cfg("colorCommercial", "#EFDABE");
      cfg("colorEducation", "#EFDABE");
      cfg("colorMedical", "#EFDABE");
      cfg("colorIndustrial", "#EFDABE");
      cfg("colorRoads", "#FDF4E7");
      cfg("roadsBrightness", 0.5);
      cfg("colorMotorways", "#EAB894"); // sand
      cfg("colorTrunks", "#EFC49E");
      cfg("colorGreenspace", "#AFC58F"); // parks matter to sightseers — green
      cfg("colorWater", "#C2CDD3");
      cfg("colorPlaceLabels", "#351D06"); // espresso
      cfg("colorAdminBoundaries", "#C9A87F");

      /* The dashed district outline was removed on 2026-08-16 (Adam): the
       * photo pins and the position radar carry "this is your patch" on
       * their own, and the polygon was only ever an approximation. */

      /* Curated landmarks: the only POIs on this map. Temples, shrines,
       * gardens, museums and historic sites — the things a story would
       * actually be written about — from Mapbox's own Streets tileset.
       * `filterrank` is Mapbox's prominence score (1 = most prominent), so
       * this keeps the landmarks a visitor would recognise and drops the
       * long tail. */
      map.addSource("landmarks", {
        type: "vector",
        url: "mapbox://mapbox.mapbox-streets-v8",
      });

      /* Temples, shrines, gardens, museums, historic sites — and nothing
       * else. Deliberately NOT filtered by Mapbox's `filterrank`: in Yanaka
       * the interesting places are small, so they rank 3–5 and a strict rank
       * cut removes exactly what we came for. Class does the work instead;
       * `arts_and_entertainment` is narrowed by maki so cinemas and
       * nightlife don't sneak in. */
      const landmarkFilter = [
        "any",
        [
          "in",
          ["get", "class"],
          ["literal", ["park_like", "historic", "religion"]],
        ],
        [
          "in",
          ["get", "maki"],
          [
            "literal",
            [
              "museum",
              "art-gallery",
              "monument",
              "attraction",
              "castle",
              "garden",
              "religious-shinto",
              "religious-buddhist",
              "place-of-worship",
            ],
          ],
        ],
      ] as unknown as never;

      map.addLayer({
        id: "landmark-labels",
        type: "symbol",
        source: "landmarks",
        "source-layer": "poi_label",
        slot: "top",
        minzoom: 13,
        filter: landmarkFilter,
        layout: {
          "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
          "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
          "text-size": 12,
          "text-offset": [0, 1.1],
          "text-anchor": "top",
          "text-max-width": 9,
          "text-padding": 6,
          "icon-allow-overlap": false,
        },
        paint: {
          // Espresso-soft on the cream ground, cream halo for legibility.
          "text-color": "#5F452A",
          "text-halo-color": "#FEF0E3",
          "text-halo-width": 1.3,
          "text-opacity": 0.95,
        },
      });

      // A small sand dot under each curated name, so they read as places.
      map.addLayer(
        {
          id: "landmark-dots",
          type: "circle",
          source: "landmarks",
          "source-layer": "poi_label",
          slot: "top",
          minzoom: 13,
          filter: landmarkFilter,
          paint: {
            // Quieter than the terracotta story pins on purpose.
            "circle-radius": 3,
            "circle-color": "#6B4A2F",
            "circle-opacity": 0.8,
            "circle-stroke-width": 1.5,
            "circle-stroke-color": "#FEF0E3",
            "circle-stroke-opacity": 0.8,
          },
        },
        "landmark-labels",
      );
    });

    // Adopt the server-rendered pin buttons as geo-anchored markers.
    pins.forEach((pin) => {
      const [lng, lat] = (pin.dataset.lnglat || "0,0").split(",").map(Number);
      // occludedOpacity 1: GL v3 fades markers hidden behind 3D buildings to
      // 20% — at dusk on this palette that reads as "no pins at all".
      // The pins are UI, not scenery; they must always win.
      new mapboxgl.Marker({
        // "bottom": the pin's point sits on the coordinate, the photo stacks
        // above it — anchoring centre would float the place off its spot.
        element: pin,
        anchor: "bottom",
        occludedOpacity: 1,
      })
        .setLngLat([lng, lat])
        .addTo(map);

      pin.addEventListener("click", () => {
        openStop(pin, [lng, lat]);
      });
    });

    /* Story popups. The card is CLONED out of the server-rendered block, so
     * the original text stays in the DOM for crawlers and no-JS visitors
     * while the popup gets its own copy to own and destroy. */
    let popup: import("mapbox-gl").Popup | null = null;

    const openStop = (
      pin: HTMLButtonElement,
      at: [number, number],
      ease = true,
    ) => {
      const card = cardFor(pin.dataset.stop);
      if (!card) return;

      popup?.remove();
      clearPins();
      pin.setAttribute("aria-expanded", "true");

      const content = card.cloneNode(true) as HTMLElement;
      content.removeAttribute("id");
      content.hidden = false;

      // Below lg: render into the in-flow slot under the copy, not a popup.
      if (!window.matchMedia("(min-width: 1024px)").matches) {
        const slot = document.getElementById("stop-slot");
        if (slot) {
          slot.replaceChildren(content);
          // No recentring here: the card is below the map, so moving the map
          // only pushes the other four pins out of a small viewport.
          window.dispatchEvent(new CustomEvent("curio:pin-opened"));
          return;
        }
      }

      popup = new mapboxgl.Popup({
        className: "walk-popup",
        offset: 92, // clears the photo pin, which is ~86px tall with its label
        maxWidth: "320px",
        focusAfterOpen: false,
        closeOnMove: false,
        /* Must be false: the marker click bubbles to the map, and with the
         * default `true` Mapbox closes the popup with the very click that
         * opened it. Closing is handled by the ✕, by opening another pin,
         * and by the map-click handler registered below. */
        closeOnClick: false,
      })
        .setLngLat(at)
        .setDOMContent(content)
        .addTo(map);

      popup.on("close", clearPins);
      openedAt = Date.now();

      // Nudge the map so the popup has room above the pin.
      if (ease) map.easeTo({ center: at, duration: 900, offset: [0, 90] });
      window.dispatchEvent(new CustomEvent("curio:pin-opened"));
    };

    /* Tapping bare map closes the story. Guarded by a timestamp because the
     * opening click reaches the map a tick later and would close it again. */
    let openedAt = 0;
    map.on("click", () => {
      if (popup && Date.now() - openedAt > 250) {
        popup.remove();
        popup = null;
      }
    });

    /* Hypothetical position + radar. Explicitly not geolocation: the marker
     * sits on a hard-coded point and says "example" on its label. */
    const me = document.getElementById("demo-me");
    if (me) {
      const [mlng, mlat] = (me.dataset.lnglat || "0,0").split(",").map(Number);
      me.hidden = false;
      new mapboxgl.Marker({
        element: me,
        anchor: "center",
        occludedOpacity: 1,
      })
        .setLngLat([mlng, mlat])
        .addTo(map);
    }

    // Staging box has served its purpose.
    staging?.classList.remove("flex", "absolute");

    /* Desktop opens one stop on arrival so the mechanic explains itself —
     * without easing, or it would fight the framing we just computed. On
     * touch the map starts clean: a popup covering a small screen before
     * anyone has tapped is an obstacle, not an invitation. */
    if (window.matchMedia("(min-width: 1024px)").matches && pins[0]) {
      // Not gated on "idle": that event is unreliable in embedded webviews,
      // and the popup positions itself correctly regardless.
      const at = (pins[0].dataset.lnglat || "0,0")
        .split(",")
        .map(Number) as [number, number];
      openStop(pins[0], at, false);
    }
  };

  if ("IntersectionObserver" in window && mapEl) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          boot();
        }
      },
      { rootMargin: "600px 0px" },
    );
    io.observe(mapEl);
  }
  // Fallback: idle-boot even if the observer never fires.
  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(() => boot(), { timeout: 4000 });
  } else {
    setTimeout(() => boot(), 2500);
  }
</script>
