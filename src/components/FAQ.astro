---
/*
 * Real SEO surface — this is most of the page's indexable word count, and it
 * answers the questions the old page left open (cost, length, offline, who
 * writes it, who's behind it). Content lives in src/data/faq.ts, shared with
 * the FAQPage JSON-LD in Base.astro.
 */
import { faqs } from "../data/faq";
---

<section class="px-4 py-16 sm:px-6 sm:py-20" id="faq">
  <div class="mx-auto max-w-3xl">
    <div class="reveal mb-10">
      <h2 class="display-lg text-espresso">Questions.</h2>
    </div>

    <div class="divide-y divide-espresso/10">
      {
        faqs.map((f) => (
          <details class="group reveal py-5">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-bold text-espresso"
            >
              {f.q}
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-sand/50 text-terracotta transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path
                    d="M7 1v12M1 7h12"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl pr-14 leading-relaxed text-espresso/70">
              {f.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
